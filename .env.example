# Postgres (docker-compose up -d db)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_watch

# Copernicus Data Space (register at dataspace.copernicus.eu)
CDSE_CLIENT_ID=your-oauth2-client-id
CDSE_CLIENT_SECRET=your-oauth2-client-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App settings (optional)
TEMP_DIR=/tmp/sentinel-watch
LOG_LEVEL=INFO
